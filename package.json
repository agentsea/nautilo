{
  "name": "nautilo-monorepo",
  "private": true,
  "description": "Nautilo — personal AI framework with identity, memory, and multi-channel presence",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "TURBO_CONCURRENCY=${TURBO_CONCURRENCY:-1} NODE_OPTIONS=--max-old-space-size=5120 turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration --concurrency=1",
    "test:invariants": "bun test --timeout 60000 ./dev/tests/repo-invariants/",
    "encryption:inventory": "bun run --cwd packages/encryption-invariants inventory",
    "encryption:check": "bun run --cwd packages/encryption-invariants check",
    "encryption:indicators": "bash dev/scripts/ci-gates.sh encryption-indicators",
    "encryption:assurance": "bash dev/scripts/ci-gates.sh encryption-assurance",
    "db:query-inventory": "bun run --cwd packages/query-invariants inventory",
    "db:query-inventory:check": "bun run --cwd packages/query-invariants check",
    "limits:inventory": "bun run --cwd packages/limit-invariants inventory",
    "limits:report": "bun run --cwd packages/limit-invariants report",
    "limits:check": "bun run --cwd packages/limit-invariants check",
    "limits:scout": "bun run --cwd packages/limit-invariants scout",
    "limits:eval-agent": "bun dev/tools/limit-preflight/evaluate-live-agent.ts",
    "test:mutation:d486": "stryker run stryker.d486.config.mjs",
    "test:integration:quick": "turbo run test:integration:quick",
    "test:integration:officecli": "bun run officecli:verify && bun test --timeout 120000 packages/server/tests/integration/officecli-create-roundtrip.integration.test.ts",
    "test:integration:server": "bun test --timeout 60000 packages/server/tests/integration/",
    "test:integration:ai": "bun test --timeout 60000 packages/runtime/tests/integration/",
    "eval:official-skills": "bun dev/evals/official-skills/evaluate.ts",
    "security:vulnerability-exceptions": "bun packaging/docker/check-vulnerability-exception-expiry.ts --warning-days 14 packaging/docker/server-vulnerability-exceptions.input.json packaging/docker/bootstrap-vulnerability-policy.input.json",
    "clean": "turbo run clean && rm -rf dist .turbo node_modules",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:push": "turbo run db:push",
    "db:studio": "turbo run db:studio",
    "db:dev": "turbo run db:dev",
    "db:dev:down": "cd packages/db && docker compose -f docker/docker-compose.yml down",
    "server": "NAUTILO_HOST=${NAUTILO_HOST:-127.0.0.1} bun bin/nautilo-server/src/index.ts",
    "server:start": "bun bin/nautilo-dev/src/index.ts server-start",
    "server:status": "bun bin/nautilo-dev/src/index.ts server-status",
    "server:stop": "bun bin/nautilo-dev/src/index.ts server-stop",
    "server:restart": "bun bin/nautilo-dev/src/index.ts server-restart",
    "cli": "bun apps/cli/src/index.ts",
    "desktop": "cd apps/desktop && bun run app",
    "desktop:build": "cd apps/desktop && bun run package:dev && echo \"Desktop binary built under $(pwd)/release (e.g. release/mac-arm64/Nautilo.app)\"",
    "desktop:package:mac": "cd apps/desktop && bun run package:mac && echo \"Desktop installer built under $(pwd)/release\"",
    "desktop:package:linux": "cd apps/desktop && bun run package:linux && echo \"Desktop installer built under $(pwd)/release\"",
    "desktop:package:win": "cd apps/desktop && bun run package:win && echo \"Desktop installer built under $(pwd)/release\"",
    "mobile:web:export": "bun run --cwd apps/mobile export:web",
    "mobile:local:preflight": "bun scripts/mobile-local-preflight.ts",
    "build:artifacts": "bun --cwd=packages/workbench-components run build && bun --cwd=apps/workbench run build && bun run mobile:web:export",
    "docker:runtime-install:generate": "bun packaging/docker/generate-runtime-install.ts",
    "docker:runtime-install:check": "bun packaging/docker/generate-runtime-install.ts --check",
    "agent-browser:vendor": "bun dev/scripts/vendor-agent-browser.ts",
    "officecli:vendor": "bun dev/scripts/vendor-officecli.ts",
    "officecli:verify": "bun dev/scripts/officecli/verify.ts",
    "dev-stack": "bun bin/nautilo-dev/src/index.ts dev-stack",
    "dev:qualify-owner-claim": "bun bin/nautilo-dev/src/index.ts qualify-owner-claim",
    "office:up": "bun bin/nautilo-dev/src/index.ts office up",
    "office:down": "bun bin/nautilo-dev/src/index.ts office down",
    "office:status": "bun bin/nautilo-dev/src/index.ts office status",
    "oss": "exec bun bin/nautilo-local/src/oss-retired.ts",
    "reset-pin": "bun bin/nautilo-reset-pin/src/index.ts",
    "lint:unused": "NODE_OPTIONS=--max-old-space-size=6144 NAUTILO_DRIZZLE_OFFLINE=1 knip --cache --no-progress",
    "ci:local": "bash dev/scripts/ci-local.sh",
    "setup": "lefthook install",
    "first-party-apps:install": "bun dev/scripts/install-first-party-apps.ts",
    "writer:prepare": "turbo run build --filter=@nautilo/office-docs...",
    "sheets:prepare": "bun dev/scripts/prepare-sheets.ts",
    "postinstall": "lefthook install && bun run writer:prepare && bun run first-party-apps:install && bun dev/scripts/fix-node-pty-perms.ts",
    "dev:test": "cd dev && bun test --timeout 60000",
    "ptt:build": "cd native/macos-ptt-helper && swift build",
    "dev:save": "bun bin/nautilo-dev/src/index.ts save",
    "dev:clone": "bun bin/nautilo-dev/src/index.ts clone",
    "dev:compact-checkpoints": "bun bin/nautilo-dev/src/index.ts compact-checkpoints",
    "dev:restore": "bun bin/nautilo-dev/src/index.ts restore",
    "dev:preflight": "bun bin/nautilo-dev/src/index.ts preflight",
    "dev:inspect": "bun bin/nautilo-dev/src/index.ts inspect",
    "dev:verify": "bun bin/nautilo-dev/src/index.ts verify",
    "dev:verify-postgres-databases": "bun bin/nautilo-dev/src/index.ts verify-postgres-databases",
    "dev:verify-config-env": "bun bin/nautilo-dev/src/index.ts verify-config-env",
    "dev:verify-pool-lifecycle": "bun bin/nautilo-dev/src/index.ts verify-pool-lifecycle",
    "dev:upgrade": "bun bin/nautilo-dev/src/index.ts upgrade",
    "dev:reset-logto-admin-password": "bun bin/nautilo-dev/src/index.ts reset-logto-admin-password",
    "dev:clean": "bun bin/nautilo-dev/src/index.ts clean",
    "dev:cleanup-instances": "bun bin/nautilo-dev/src/index.ts cleanup-instances",
    "dev:reset-test-cruft": "bun bin/nautilo-dev/src/index.ts reset-test-cruft",
    "dev:nuke-client-cache": "bun bin/nautilo-dev/src/index.ts nuke-client-cache",
    "dev:list": "bun bin/nautilo-dev/src/index.ts list",
    "dev:list-instances": "bun bin/nautilo-dev/src/index.ts list-instances",
    "dev:gen-setup-template": "bun bin/nautilo-dev/src/index.ts gen-setup-template",
    "dev:delete-instance": "bun bin/nautilo-dev/src/index.ts delete-instance",
    "dev:protect-instance": "bun bin/nautilo-dev/src/index.ts protect-instance",
    "infra:list": "bun bin/nautilo-dev/src/index.ts list-instances",
    "infra:start": "bun bin/nautilo-dev/src/index.ts infra-start",
    "infra:start:shared": "bun bin/nautilo-dev/src/index.ts infra-start",
    "infra:stop": "bun bin/nautilo-dev/src/index.ts infra-stop",
    "infra:stop:shared": "bun bin/nautilo-dev/src/index.ts infra-stop",
    "infra:status": "bun bin/nautilo-dev/src/index.ts infra-status",
    "dev:mark-all-messages-read": "bun bin/nautilo-dev/src/index.ts mark-all-messages-read",
    "dev:migrate-to-logto": "bun bin/nautilo-dev/src/index.ts migrate-to-logto",
    "dev:migrate-from-logto": "bun bin/nautilo-dev/src/index.ts migrate-from-logto",
    "dev:migrate-to-username-identity": "bun bin/nautilo-dev/src/index.ts migrate-to-username-identity",
    "dev:migrate-artifacts": "bun bin/nautilo-dev/src/index.ts migrate-artifacts",
    "photo-library:gc": "bun run --cwd packages/server photo-library:gc",
    "photo-library:recover": "bun run --cwd packages/server photo-library:recover",
    "dev:migrate-add-agent-role": "bun bin/nautilo-dev/src/index.ts migrate-add-agent-role",
    "dev:repair-logto-account-security": "bun bin/nautilo-dev/src/index.ts repair-logto-account-security",
    "dev:reset-logto-user-password": "bun bin/nautilo-dev/src/index.ts reset-logto-user-password",
    "dev:verify-user-link": "bun bin/nautilo-dev/src/index.ts verify-user-link",
    "dev:setup": "bun bin/nautilo-dev/src/index.ts setup-instance",
    "dev:setup-status": "bun bin/nautilo-dev/src/index.ts setup-status",
    "slides:prepare": "bun dev/scripts/prepare-slides.ts",
    "board:prepare": "bun run dev/scripts/prepare-board.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@stryker-mutator/core": "9.6.1",
    "bun-types": "1.3.11",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "happy-dom": "20.11.6",
    "knip": "5.88.1",
    "lefthook": "2.1.5",
    "smol-toml": "1.8.0",
    "turbo": "2.10.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.0"
  },
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "packages/*",
    "packages/first-party-apps/board",
    "apps/*",
    "bin/*",
    "dev/tools/*",
    "deploy/compose-driver"
  ],
  "engines": {
    "node": "24.x",
    "bun": "1.3.11"
  },
  "trustedDependencies": [
    "electron",
    "esbuild",
    "lefthook",
    "node-pty"
  ],
  "overrides": {
    "@hono/node-server": "1.19.15",
    "@langchain/openai": "1.4.5",
    "@langchain/langgraph-checkpoint": "1.0.1",
    "@xmldom/xmldom": "0.9.12",
    "body-parser": "2.3.0",
    "electron-builder-squirrel-windows": "26.15.3",
    "form-data": "4.0.6",
    "hono": "4.12.34",
    "js-yaml": "4.3.1",
    "jose": "6.2.3",
    "linkify-it": "5.0.2",
    "markdown-it": "14.3.0",
    "plist": "3.1.1",
    "postcss": "8.5.26",
    "qs": "6.15.3",
    "tar": "7.5.22",
    "tmp": "0.2.7"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@xmldom/xmldom": "0.9.12",
    "kdbxweb": "2.1.1",
    "zod": "4.3.6"
  },
  "patchedDependencies": {
    "@oomol-lab/connector@1.1.0": "patches/@oomol-lab%2Fconnector@1.1.0.patch",
    "@expo/plist@0.8.1": "patches/@expo%2Fplist@0.8.1.patch",
    "@assistant-ui/react-lexical@0.2.4": "patches/@assistant-ui%2Freact-lexical@0.2.4.patch",
    "@langchain/langgraph@1.2.9": "patches/@langchain%2Flanggraph@1.2.9.patch"
  }
}
