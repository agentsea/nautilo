# deploy/compose-driver/templates/.env.example
# Copy to .env (mode 0600) and fill in real values before running
# `docker compose up`. The server exits with code 2 if required
# server-side vars are missing (DB_CONNECTION_STRING, NAUTILO_BOOTSTRAP_TOKEN,
# at least one provider key). Logto-container vars are validated by
# the Logto container itself, not by nautilo-server.

# ─── Hosting mode ───────────────────────────────────────────────────────
NAUTILO_HOSTING_MODE=cloud

# ─── Provider keys (set at least ONE of these) ──────────────────────────
# nautilo-server's cloud-env-guard requires at least one of these to be
# non-empty. The agent layer can't function without a provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ─── Nautilo server (required) ──────────────────────────────────────────
# Bootstrap token bearer for remote CLI claim (consumed by
# requestAllowsPrivilegedSetup in packages/server/src/lib/request-trust.ts
# once D120 A5 lands; enforced here so cloud boots are forced to set it).
# Generate: `openssl rand -hex 32`
NAUTILO_BOOTSTRAP_TOKEN=

# M120 Phase 0 spike: bearer shared with Logto's HTTP Email connector when
# validating hosted ForgotPassword without SMTP. Generate: `openssl rand -hex 32`
# and configure the Logto connector Authorization as `Bearer <value>`.
NAUTILO_LOGTO_HTTP_EMAIL_WEBHOOK_SECRET=

# D458 Wave 7: stable per-instance HMAC pepper for remote-controller pairing.
# `nautilo deploy` generates and persists this automatically. Do not reuse it
# across instances or expose it to mobile/desktop clients.
NAUTILO_REMOTE_PAIRING_PEPPER=

# ─── Database (required: server-side reader) ────────────────────────────
# packages/db/src/config/database.ts reads DB_CONNECTION_STRING and
# throws if missing. The compose entrypoint should derive this from
# the POSTGRES_* component vars below before exec'ing nautilo-server.
DB_CONNECTION_STRING=
# Direct (admin) DB connection for migrations and drizzle-kit
# (packages/db/drizzle.config.ts prefers this over DB_CONNECTION_STRING).
# Falls back to resolveInstance().db.directConnection when unset.
# DB_DIRECT_CONNECTION=

# ─── Postgres component vars (compose-side, NOT read by nautilo-server) ─
# The compose stack assembles these into DB_CONNECTION_STRING in the
# entrypoint. nautilo-server itself does not read POSTGRES_*.
POSTGRES_HOST=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ─── Logto container (compose-side, NOT read by nautilo-server) ─────────
# These configure the Logto container in the same compose file. The
# nautilo-server boot guard does NOT validate them — a missing value
# here surfaces as Logto admin requests failing in the Logto container
# logs, not in the server's exit code.
LOGTO_ADMIN_PASSWORD=
LOGTO_DB_PASSWORD=
NAUTILO_CRYPTO_DB_PASSWORD=

# ─── Office engine (M201) ───────────────────────────────────────────────
# Collabora coolwsd base image for the `collabora` service's fonts-overlay
# build (COOLWSD_BASE build arg). Mirror DEPENDENCY_PINS.collabora in
# deploy/dependency-pins.ts.
COLLABORA_IMAGE=collabora/code:26.04.1.4.1
# coolwsd must emit URLs the browser can reach (not the internal collabora
# host). NAUTILO_PUBLIC_HOST = host:port the browser uses (no scheme);
# NAUTILO_COOLWSD_SSL_TERMINATION = true only behind edge TLS (Caddy), else
# false (plain http → ws). `nautilo deploy` fills these automatically.
NAUTILO_PUBLIC_HOST=
NAUTILO_COOLWSD_SSL_TERMINATION=false

# ─── Forward-looking placeholders (not yet consumed) ────────────────────
# NAUTILO_SESSION_JWT_SECRET is reserved for a future session-store
# migration. Leave unset; not enforced by the boot guard today.
# NAUTILO_SESSION_JWT_SECRET=
