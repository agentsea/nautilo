# M114 — isolated deploy-stack compose env (local smoke). Copy to `.env`, then:
#   docker compose --profile auth --profile app up -d --build
#
# Manual-smoke developer-convenience path only — `nautilo deploy` (CLI path)
# generates random per-instance DB passwords on first deploy and persists them
# to ~/.nautilo${suffix}/instance.env.
#
# M116 — `nautilo deploy` (CLI path) generates random per-instance DB
# passwords on first deploy and persists them to ~/.nautilo${suffix}/instance.env.
# The fallbacks below are ONLY consumed by the manual smoke path
# (scripts/m114-docker-smoke.sh + this file). Do not rely on them in
# production deployments.
#
# Do NOT confuse with `deploy/compose-driver/templates/.env.example` — that file is the
# D120 cloud placeholder (NAUTILO_HOSTING_MODE=cloud, bootstrap token, etc.).
#
# Topology mirrors dev — two Postgres clusters + Logto OSS (direct PostgreSQL).
# Every default below is chosen to NOT collide with the dev stack
# (`bun run infra:start` + legacy db compose):
#
#   Compose project: nautilo-deploy            (dev: `nautilo`)
#   App Postgres:    6434 host → 5432 in-net   (dev legacy-postgres: 5434)
#   Logto Postgres:  6432 host → 5432 in-net   (dev: 5432)
#   Logto core:      4301                       (dev: 3301)
#   Logto admin:     4302                       (dev: 3302)
#   Server:          4001                       (dev: 3001)

COMPOSE_PROJECT_NAME=nautilo-deploy

# App DB cluster (app-postgres direct)
APP_DB_PASSWORD=postgres
NAUTILO_DEPLOY_APP_DB_PORT=6434

# Logto DB cluster (postgres + postgres-init.sh)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
NAUTILO_DB_PASSWORD=nautilo
LOGTO_DB_PASSWORD=logto
NAUTILO_AGENT_DB_PASSWORD=nautilo_agent
NAUTILO_CRYPTO_DB_PASSWORD=nautilo_crypto
NAUTILO_DEPLOY_DB_PORT=6432

# Third-party images — keep in sync with deploy/dependency-pins.ts
POSTGRES_IMAGE=postgres:16
PGVECTOR_IMAGE=pgvector/pgvector:pg17
LOGTO_IMAGE=ghcr.io/logto-io/logto:1.38.0
LOGTO_IMAGE_TAG=1.38.0
# M201 — Collabora coolwsd base image for the `office` profile (used as the
# COOLWSD_BASE build arg on the `collabora` service). Mirror
# DEPENDENCY_PINS.collabora in deploy/dependency-pins.ts.
COLLABORA_IMAGE=collabora/code:26.04.1.4.1
NAUTILO_DEPLOY_LOGTO_PORT=4301
NAUTILO_DEPLOY_LOGTO_ADMIN_PORT=4302
LOGTO_ENDPOINT=http://localhost:4301
LOGTO_ADMIN_ENDPOINT=http://localhost:4302
LOGTO_CONTAINER_ADMIN_ENDPOINT=http://127.0.0.1:4302
LOGTO_TRUST_PROXY=0

# Server (nautilo-server service — env also set in docker-compose.yml)
NAUTILO_SERVER_TAG=local-dev
# Filled from a clean checkout by scripts/m114-docker-smoke.sh.
NAUTILO_SOURCE_SHA=
NAUTILO_DEPLOY_SERVER_PORT=4001
# M201 — office (coolwsd) needs the BROWSER-facing origin/host so it emits URLs
# the browser can reach (not the internal `collabora:9980`). Match the port you
# open in the browser. Plain-http local smoke → ssl.termination=false (ws/http).
NAUTILO_PUBLIC_BASE_URL=http://localhost:4001
NAUTILO_PUBLIC_HOST=localhost:4001
NAUTILO_COOLWSD_SSL_TERMINATION=false
NAUTILO_HOSTING_MODE=local
# Empty = default instance (manual smoke). `nautilo deploy` fills this with the
# profile's instance_id so the base template's ${NAUTILO_INSTANCE_ID:-} resolves.
NAUTILO_INSTANCE_ID=
