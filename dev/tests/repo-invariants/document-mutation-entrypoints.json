{
  "schemaVersion": 1,
  "purpose": "Narrow D448 inventory of production modules that can commit document bytes, artifact rows, revisions, or document-file structural changes. This is not a repository-wide writeFile ceiling.",
  "dispositions": [
    "planner",
    "coordinator_adapter",
    "compatibility_only",
    "excluded"
  ],
  "owners": [
    "workspace_backend",
    "desktop_backend",
    "coordinator",
    "importer",
    "filesystem_ui"
  ],
  "scanRoots": [
    "packages/agent/src/tools/file",
    "packages/agent/src/tools/apply-patch",
    "packages/agent/src/tools/office",
    "packages/agent/src/tools/convert",
    "packages/agent/src/tools/media",
    "packages/server/src/routes/workspace-artifacts.ts",
    "packages/server/src/routes/wopi.ts",
    "packages/server/src/apps",
    "apps/desktop/electron",
    "apps/workbench/src/editors",
    "apps/workbench/src/apps",
    "apps/workbench/src/components/browser-column"
  ],
  "exclusions": [
    {
      "path": "apps/desktop/electron/desktop-filesystem-grants",
      "reason": "Desktop grant/authentication state, not document bytes."
    },
    {
      "path": "apps/desktop/electron/workstation-profiles",
      "reason": "Desktop profile/app state, not document bytes."
    },
    {
      "path": "apps/desktop/electron/workstation-shell-consent-store.ts",
      "reason": "Desktop workstation-consent receipt state, not document bytes."
    },
    {
      "path": "apps/desktop/electron/local-file-history/storage.ts",
      "reason": "Journal payload persistence internals; callers are classified, not the journal's storage implementation."
    },
    {
      "path": "apps/desktop/electron/scratch",
      "reason": "Private experimental staging, never production authority.",
      "optional": true
    },
    {
      "path": "apps/desktop/tests",
      "reason": "Tests and fixtures are not production authority."
    },
    {
      "path": "apps/desktop/electron/preload.ts",
      "reason": "Renderer IPC bridge declares channels but cannot commit bytes itself."
    },
    {
      "path": "packages/agent/src/tools/file/share-artifact.ts",
      "reason": "Namespace-only sharing changes attachment visibility, not document bytes or document structure."
    },
    {
      "path": "apps/workbench/src/components/browser-column/artifact-tree.ts",
      "reason": "In-memory UI tree construction uses a coincidental insertArtifact name and has no storage authority."
    },
    {
      "path": "node_modules",
      "reason": "Third-party dependencies are outside repository production source."
    },
    {
      "path": "dist",
      "reason": "Built output is not source authority.",
      "optional": true
    },
    {
      "path": "release",
      "reason": "Packaged output is not source authority.",
      "optional": true
    }
  ],
  "primitivePatterns": [
    {
      "id": "workspace_row_change",
      "source": "\\bapplyWorkspaceArtifactRowChange\\s*\\("
    },
    {
      "id": "workspace_structural_row",
      "source": "\\b(?:insertArtifact|attachArtifactToNamespace|updateArtifactPath|markArtifactDeleted)\\s*\\("
    },
    {
      "id": "workspace_revision",
      "source": "\\brecordRevision\\s*\\("
    },
    {
      "id": "workspace_text_save",
      "source": "\\buserSaveWorkspaceArtifact\\s*\\("
    },
    {
      "id": "workspace_text_patch",
      "source": "\\bapplyWorkspaceArtifactTextPatch\\s*\\("
    },
    {
      "id": "workspace_content_commit_execution",
      "source": "\\bgetWorkspaceFileContentCommitExecution\\s*\\("
    },
    {
      "id": "workspace_content_recovery_execution",
      "source": "\\bgetWorkspaceFileContentRecoveryExecution\\s*\\("
    },
    {
      "id": "workspace_binary_create",
      "source": "\\bcreateWorkspaceBinaryArtifact\\s*\\("
    },
    {
      "id": "workspace_staged_patch",
      "source": "\\bapplyEphemeralPatch\\s*\\("
    },
    {
      "id": "workspace_binary_patch",
      "source": "\\bapplyBinaryContentPatch(?:\\s*|\\))\\("
    },
    {
      "id": "workspace_atomic_bytes",
      "source": "\\bwriteAtomic\\s*\\("
    },
    {
      "id": "workspace_route_direct_bytes",
      "source": "\\b(?:writeFile|createWriteStream)\\s*\\(",
      "modules": [
        "packages/server/src/routes/workspace-artifacts.ts"
      ]
    },
    {
      "id": "workspace_generated_direct_bytes",
      "source": "\\bwriteFile\\s*\\(",
      "modules": [
        "packages/agent/src/tools/office/office.ts",
        "packages/agent/src/tools/media/generate-image.ts"
      ]
    },
    {
      "id": "wopi_post_image",
      "source": "\\bpersistArtifactBytes\\s*\\("
    },
    {
      "id": "wopi_direct_bytes",
      "source": "\\bfsWriteFile\\s*\\("
    },
    {
      "id": "wopi_revision_bump",
      "source": "\\bbumpArtifactRevision\\s*\\(",
      "modules": [
        "packages/server/src/routes/wopi.ts"
      ]
    },
    {
      "id": "desktop_guarded_bytes",
      "source": "\\badapter\\.writeFile\\s*\\("
    },
    {
      "id": "desktop_office_commit",
      "source": "\\bwriteOutputWithJournal\\s*\\("
    },
    {
      "id": "desktop_journal_commit",
      "source": "\\brecordSuccessfulMutation\\s*\\("
    },
    {
      "id": "desktop_journal_restore",
      "source": "\\bjournal\\.(?:undo|redo|undoTurn)\\s*\\("
    },
    {
      "id": "desktop_ipc_write",
      "source": "\\\"fs:writeFile\\\""
    },
    {
      "id": "desktop_ipc_rename",
      "source": "\\\"fs:rename\\\""
    },
    {
      "id": "desktop_ipc_trash",
      "source": "\\\"fs:trash\\\""
    },
    {
      "id": "desktop_ipc_atomic_write",
      "source": "\\bwriteFileAtomically\\s*\\("
    },
    {
      "id": "desktop_trash_effect",
      "source": "\\bshell\\.trashItem\\s*\\("
    },
    {
      "id": "renderer_local_write",
      "source": "\\bdesktopAPI\\.fs\\.writeFile\\s*\\("
    },
    {
      "id": "renderer_local_rename",
      "source": "\\bdesktopAPI\\.fs\\.rename\\b"
    },
    {
      "id": "renderer_local_trash",
      "source": "\\bdesktopAPI\\.fs\\.trash\\b"
    },
    {
      "id": "writer_accepted_commit",
      "source": "\\bwriteAccepted\\s*\\("
    }
  ],
