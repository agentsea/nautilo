{
  "name": "@nautilo/workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web workbench — Genie's browser home (React + Vite SPA)",
  "scripts": {
    "build": "tsc -b && bun --bun vite build",
    "typecheck": "tsc --noEmit",
    "preview": "bun --bun vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "probe:ooxml-contract": "bun run scripts/ooxml-contract-probe.ts",
    "probe:ooxml-delivery": "bun run scripts/ooxml-delivery-probe.ts",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "bun run scripts/run-unit-isolated.ts",
    "test:integration": "bun test --timeout 60000 tests/integration/"
  },
