+/// Read only sheets directly attached to an exact native window. In particular,
+/// do not traverse its web document to discover a sheet: Chromium places native
+/// sheets after that document in AXChildren, regardless of the page's size.
+/// Returned actionable nodes follow TreeWalkResult's retained-pointer contract.
+pub(crate) fn walk_window_sheets(pid: i32, window_id: u32, max_elements: usize) -> TreeWalkResult {
+    let mut nodes = Vec::new();
+    let mut lines = Vec::new();
+    let mut counter = 0;
+    let mut visited = 0;
+    let mut truncated = false;
+    let mut matched = false;
+    unsafe {
+        let app = AXUIElementCreateApplication(pid);
+        if !app.is_null() {
+            set_messaging_timeout(app);
+            super::enablement::ensure_chromium_ax_enabled(pid, app);
+            let windows = copy_ax_windows(app);
+            let mut sheets = Vec::new();
+            for &window in &windows {
+                set_messaging_timeout(window);
+                if copy_string_attr(window, "AXRole").as_deref() != Some("AXWindow")
+                    || ax_get_window_id(window) != Some(window_id)
+                {
+                    continue;
+                }
+                matched = true;
+                let Some(children) = copy_element_array_attr_checked(window, "AXChildren") else {
+                    truncated = true;
+                    continue;
+                };
+                let candidates = copy_element_array_attr(window, "AXSheets")
+                    .into_iter()
+                    .chain(children)
+                    .collect::<Vec<_>>();
+                let selected = direct_sheet_roots(
+                    &candidates,
+                    |element| {
+                        set_messaging_timeout(*element);
+                        copy_string_attr(*element, "AXRole").unwrap_or_else(|| {
+                            truncated = true;
+                            String::new()
+                        })
+                    },
+                    |left, right| CFEqual(*left as CFTypeRef, *right as CFTypeRef) != 0,
+                );
+                for sheet in selected {
+                    if !sheets
+                        .iter()
+                        .any(|&other| CFEqual(other as CFTypeRef, sheet as CFTypeRef) != 0)
+                    {
+                        CFRetain(sheet as CFTypeRef);
+                        sheets.push(sheet);
+                    }
+                }
+                for element in candidates {
+                    CFRelease(element as CFTypeRef);
+                }
+            }
+            for sheet in sheets {
+                walk_element(
+                    sheet,
+                    0,
+                    None,
+                    false,
+                    &mut nodes,
+                    &mut lines,
+                    &mut counter,
+                    &mut visited,
+                    &mut truncated,
+                    max_elements,
+                    // The node budget already bounds this small native sheet.
+                    // Do not silently depth-truncate a privileged uniqueness scan.
+                    max_elements,
+                );
+                CFRelease(sheet as CFTypeRef);
+            }
+            for window in windows {
+                CFRelease(window as CFTypeRef);
+            }
+            CFRelease(app as CFTypeRef);
+        }
+    }
+    TreeWalkResult {
+        tree_markdown: render_lines(&lines),
+        nodes,
+        truncated,
+        window_scope: Some(if matched {
+            WindowScope::Matched
+        } else {
+            WindowScope::AxUnresolved { ax_window_count: 0 }
+        }),
+    }
+}
+
+fn direct_sheet_roots<T: Copy>(
+    candidates: &[T],
+    mut role: impl FnMut(&T) -> String,
+    same: impl Fn(&T, &T) -> bool,
+) -> Vec<T> {
+    let mut sheets = Vec::new();
+    for candidate in candidates {
+        if role(candidate) == "AXSheet" && !sheets.iter().any(|sheet| same(sheet, candidate)) {
+            sheets.push(*candidate);
+        }
+    }
+    sheets
+}
