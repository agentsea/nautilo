+    width: u32,
+    height: u32,
+) -> screencapturekit::prelude::SCStreamConfiguration {
+    // ScreenCaptureKit includes child windows by default. Chrome's full-screen
+    // toolbar is a child above the main window: including it scales a larger
+    // composition into the main window's pixel frame and adds a black margin.
+    // Neither children nor shadows belong to our window-local coordinate space.
+    screencapturekit::prelude::SCStreamConfiguration::new()
+        .with_width(width)
+        .with_height(height)
+        .with_includes_child_windows(false)
+        .with_ignores_shadows_single_window(true)
