{
  "name": "@nautilo/cli",
  "version": "0.1.33",
  "private": false,
  "type": "module",
  "description": "Nautilo administrator and operator CLI",
  "license": "SEE LICENSE IN ../../LICENSE",
  "bin": {
    "nautilo": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "templates",
    "README.md",
    "CHANGELOG.md",
    "RELEASING.md",
    "LICENSE"
  ],
  "engines": {
    "node": "24.x",
    "bun": "1.3.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1108.0",
    "@napi-rs/keyring": "1.3.0",
    "@nautilo/api-client": "workspace:*",
    "@nautilo/cli-auth": "workspace:*",
    "@nautilo/compose-driver": "workspace:*",
    "@nautilo/compose-lifecycle": "workspace:*",
    "@nautilo/config": "workspace:*",
    "@nautilo/config-guard": "workspace:*",
    "@nautilo/db": "workspace:*",
    "@nautilo/deploy-config": "workspace:*",
    "@nautilo/hosting": "workspace:*",
    "@nautilo/operator-secrets": "workspace:*",
    "@nautilo/profile-portability": "workspace:*",
    "@nautilo/railway-hosting": "workspace:*",
    "@nautilo/types": "workspace:*",
    "@noble/ciphers": "1.3.0",
    "argon2": "0.44.0",
    "cli-table3": "0.6.5",
    "dotenv": "16.6.1",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.7",
    "smol-toml": "1.8.0",
    "yargs": "18.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.58.13",
    "@types/node": "24.10.4",
    "@types/yargs": "17.0.35",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build": "bun scripts/generate-version.ts && tsup && bun scripts/copy-compose-templates.ts",
    "build:standalone": "bun scripts/build-standalone.ts",
    "audit:standalone": "bun scripts/audit-standalone.ts",
    "qualify:standalone": "bun scripts/build-standalone.ts --qualify",
    "qualify:cloudflare-r2-oauth": "bun scripts/qualify-cloudflare-r2-oauth.ts",
    "postbuild": "chmod 755 dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun run build && bun test --max-concurrency=1",
    "test:unit": "bun run build && bun test --max-concurrency=1 tests/unit tests/lint",
    "test:integration": "bun run build && bun test --max-concurrency=1 tests/integration",
    "prepublishOnly": "bun run build && bun test"
  }
}
