--- a/dist/pregel/index.cjs
+++ b/dist/pregel/index.cjs
@@ -1055,15 +1055,14 @@ var Pregel = class extends PartialRunnable {
 			} catch (e) {
 				loopError = e;
 			} finally {
-				try {
-					if (loop) {
-						await loop.store?.stop();
-						await loop.cache?.stop();
-					}
-					await Promise.all(loop?.checkpointerPromises ?? []);
-				} catch (e) {
-					loopError = loopError ?? e;
-				}
+				// A failed save or stop must not release the turn while sibling
+				// checkpoint work is still using its invocation authority.
+				const settled = await Promise.allSettled([
+					...loop?.checkpointerPromises ?? [],
+					Promise.resolve().then(() => loop?.store?.stop()),
+					Promise.resolve().then(() => loop?.cache?.stop())
+				]);
+				for (const result of settled) if (result.status === "rejected") loopError = loopError ?? result.reason;
 				if (loopError) stream.error(loopError);
 				else stream.close();
 			}
