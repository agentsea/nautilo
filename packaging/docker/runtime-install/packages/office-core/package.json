{
  "name": "@nautilo/office-core",
  "version": "0.6.9",
  "private": true,
  "type": "module",
  "exports": {
    "./geometry": {
      "types": "./dist/geometry/index.d.ts",
      "import": "./dist/geometry/index.js",
      "require": "./dist/cjs/geometry/index.js",
      "default": "./dist/geometry/index.js"
    },
    "./image": {
      "types": "./dist/image/index.d.ts",
      "import": "./dist/image/index.js",
      "require": "./dist/cjs/image/index.js",
      "default": "./dist/image/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
