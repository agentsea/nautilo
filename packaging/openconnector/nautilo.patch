+/**
+ * Open a user-uploaded transit file without materializing its bytes. Stores
+ * predating the streaming contract retain compatibility through `read`.
+ */
+export async function openTransitFileInput(
+  input: unknown,
+  context: Pick<ApiKeyProviderContext, "transitFiles">,
+): Promise<ProviderInputStream> {
+  if (!context.transitFiles) {
+    throw new ProviderRequestError(400, "Transit file storage is not enabled.");
+  }
+
+  const reference = optionalRecord(input);
+  if (!reference) {
+    throw new ProviderRequestError(400, "file must be a transit file reference.");
+  }
+
+  const fileId = requiredString(reference.fileId, "file.fileId", (message) => new ProviderRequestError(400, message));
+  const stored = context.transitFiles.open
+    ? await context.transitFiles.open(fileId)
+    : await context.transitFiles.read(fileId).then((value) => ({
+        stream: value.file.stream() as ReadableStream<Uint8Array>,
+        sizeBytes: value.sizeBytes,
+        name: value.name,
+        mimeType: value.mimeType,
+      }));
+  return {
+    fileId,
+    stream: stored.stream,
+    name: optionalString(reference.name) ?? stored.name,
+    mimeType: optionalString(reference.mimeType) ?? stored.mimeType,
+    sizeBytes: stored.sizeBytes,
+  };
+}
