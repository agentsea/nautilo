+function createTransitUploadStore(
+  sizeBytes: number,
+  stream: () => ReadableStream<Uint8Array>,
+): {
+  store: TransitFileStore;
+  open: ReturnType<typeof vi.fn<NonNullable<TransitFileStore["open"]>>>;
+} {
+  const open = vi.fn<NonNullable<TransitFileStore["open"]>>(async () => ({
