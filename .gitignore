npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files — block everything, whitelist only .env.example
.env*
!.env.example
!.envrc.example

# nautilo CLI setup templates — block working files (may contain admin
# password, claim invite token, provider API keys); whitelist only
# example/template artifacts that ship with the repo.
#
# Working files belong in ~/.nautilo-<id>/setup.toml (chmod 600), NOT
# anywhere inside this tree. See playbook/setup-new-instance-from-scratch.md.
setup*.toml
*.setup.toml
!setup.example.toml
!**/templates/*.toml
!**/*.example.toml

# Operator / bootstrap secrets
# Real concern: never commit an env-file holding bootstrap PINs, admin
# passwords, provider API keys, etc. These two file-name rules cover it.
# A broad `**/operator-secrets/` directory-
# level belt-and-suspenders rule, but with the new `@nautilo/operator-secrets`
# package at `packages/operator-secrets/` it created a conflict that
# `!`-negations couldn't reliably resolve across all tools that read
# .gitignore — notably knip's gitignore parser handles re-includes
# poorly. The file-name rules below are sufficient defense; the runtime
# operator-secrets directory the broad rule targeted lives under
# `$HOME/.config/nautilo/`, outside any git work tree, and is further
# protected by `assertPathOutsideGitWorkTree` in the helper itself.)
secrets.env
*.secrets.env

next-env.d.ts

# docker volumes
postgres_data/

# claude
.claude/

# logs
logs/

# Electron builder output
release/

# Swift build artifacts
native/**/.build/
apps/desktop/vendor/
!apps/desktop/vendor/
apps/desktop/vendor/*
!apps/desktop/vendor/codex-runtime.manifest.json
!apps/desktop/vendor/tool-runtimes.manifest.json

*.tsbuildinfo

!.env.local-smoke.example

# CodeBoarding architecture-viz output (auto-generated, exploratory).
# Describes emergent de-facto structure, not intended design — never commit.
.codeboarding/

# Local-only, generated OOXML transport/capacity packages.
apps/workbench/tests/fixtures/ooxml/capacity/

# Raw exact-image reports are CI/release artifacts, not source inputs.
/packaging/docker/evidence/source-*/

# Local-only working notes. Tracked invariant inventories use unsuffixed names.
*.limit-audit.*
*.agent-notes.*
