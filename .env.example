# Nautilo — Environment Variables
# Copy this to .env and fill in your keys:
#   cp .env.example .env

# ─── LLM Providers ────────────────────────────────────────────────
# At minimum, set the provider for your default model (Anthropic by default)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Optional providers (only needed if you switch models)
# GOOGLE_API_KEY=...
# FIREWORKS_API_KEY=...
# XAI_API_KEY=...
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_HTTP_REFERER=https://example.com
# OPENROUTER_TITLE=Nautilo

# Venice — no-log inference proxy (Paranoid tier). Key from https://venice.ai/settings/api
# VENICE_API_KEY=...

# TypeSafe — optional Jev text classification, probability and scoring
# TYPESAFE_API_KEY=...

# Generic OpenAI-compatible gateway
# NAUTILO_GATEWAY_API_KEY=...
# NAUTILO_GATEWAY_BASE_URL=http://localhost:4000/v1
# NAUTILO_GATEWAY_LABEL=Local LLM Gateway

# ─── Tools ────────────────────────────────────────────────────────
# Required for web search and read_webpage tools
TAVILY_API_KEY=tvly-...

# ─── Database ─────────────────────────────────────────────────────
# These are the defaults for local Docker dev — usually no change needed
# DB_CONNECTION_STRING=postgres://postgres:postgres@localhost:5434/nautilo
# DB_DIRECT_CONNECTION=postgresql://postgres:postgres@localhost:5434/nautilo

# ─── Local network & instance ─────────────────────────────────────
# Defaults match `resolveInstance()` / compose `${VAR:-default}` when unset.
# COMPOSE_PROJECT_NAME=nautilo
# NAUTILO_INSTANCE_ID=
# (empty = ~/.nautilo; set to e.g. `beta` for ~/.nautilo-beta — lowercase ^[a-z0-9][a-z0-9_-]{0,30}[a-z0-9]?$)
# NAUTILO_PORT=3001
# NAUTILO_HOST=127.0.0.1
# NAUTILO_SERVER_URL=
# NAUTILO_WORKBENCH_PORT=3000
# NAUTILO_DB_PORT=5434
# NAUTILO_LOGTO_DB_PORT=5432
# NAUTILO_LOGTO_PORT=3301
# NAUTILO_LOGTO_ADMIN_PORT=3302
# NAUTILO_FEDERATED_HOSTNAME=nautilo.local
# NAUTILO_MDNS_HOSTNAME=nautilo.local
# NAUTILO_TLS_SAN=
# NAUTILO_CADDY_AUTH_HOST=auth.nautilo.local
# NAUTILO_CADDY_AUTH_ADMIN_HOST=auth-admin.nautilo.local
# NAUTILO_HOSTNAME=
# (deprecated alias for NAUTILO_FEDERATED_HOSTNAME — prefer NAUTILO_FEDERATED_HOSTNAME)

# ─── Voice (optional) ────────────────────────────────────────────
# ELEVENLABS_API_KEY=...

# ─── Model Override (optional) ───────────────────────────────────
# NAUTILO_MODEL=anthropic:claude-sonnet-4-6
# NAUTILO_MODEL=openrouter:openai/gpt-5.4-mini
# NAUTILO_MODEL=gateway:openai/gpt-oss-120b
