{
  "name": "@nautilo/attachments",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Secure attachment ingestion envelopes, policy, classification, and content adapters",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./composer-chat-extensions": "./src/composer-chat-extensions.ts",
    "./artifact-upload-policy": "./src/artifact-upload-policy.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf dist .turbo node_modules",
    "test": "bun test --timeout 15000",
    "test:unit": "bun test --timeout 15000 tests/unit/"
  },
  "dependencies": {
    "@nautilo/security": "workspace:*",
    "file-type": "22.0.1"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "typescript": "5.9.3"
  }
}
