{
  "name": "@nautilo/reflection-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "src"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "import": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "import": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf dist .turbo node_modules",
    "test": "bun run test:unit && bun run test:property",
    "test:unit": "bun test --timeout 15000 tests/unit/",
    "test:property": "bun test --timeout 15000 tests/property/",
    "test:integration": "bun scripts/run-postgres-integration.ts"
  },
  "dependencies": {
    "@nautilo/db": "workspace:*",
    "@nautilo/lattice-bridge": "workspace:*",
    "@nautilo/lattice-crypto": "workspace:*",
    "@nautilo/reflection": "workspace:*",
    "@noble/hashes": "2.2.0"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "postgres": "3.4.7",
    "typescript": "5.9.3"
  }
}
