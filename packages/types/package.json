{
  "name": "@nautilo/types",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared type definitions used across the Nautilo monorepo",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "test": "bun run test:unit",
    "test:unit": "bun test --timeout 15000 tests/unit/",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "dependencies": {
    "node-diff3": "3.2.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "bun-types": "1.3.11",
    "typescript": "5.9.3"
  }
}
