{
  "name": "@nautilo/railway-hosting",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed, redaction-safe Railway GraphQL transport for Nautilo hosting",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@nautilo/hosting": "workspace:*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf dist .turbo node_modules",
    "test": "bun run test:unit",
    "test:unit": "bun test --timeout 15000 tests/unit/"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "typescript": "5.9.3"
  }
}
