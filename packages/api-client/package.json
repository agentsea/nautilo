{
  "name": "@nautilo/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed HTTP client for the Nautilo server REST API",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf dist .turbo node_modules",
    "test": "bun test",
    "test:unit": "bun test tests/unit/"
  },
  "dependencies": {
    "@nautilo/config": "workspace:*",
    "@nautilo/config-guard": "workspace:*",
    "@nautilo/lattice-crypto": "workspace:*",
    "@nautilo/profile-portability": "workspace:*",
    "@nautilo/types": "workspace:*",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "typescript": "5.9.3"
  }
}
