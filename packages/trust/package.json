{
  "name": "@nautilo/trust",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Trust layer — PolicyResolver interface, presets, and enforcement",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf dist .turbo node_modules",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "bash scripts/run-unit.sh",
    "test:integration": "bun test --preload ./tests/test-env-preload.ts --timeout 60000 tests/integration/"
  },
  "dependencies": {
    "@langchain/core": "1.1.45",
    "@nautilo/catalog": "workspace:*",
    "@nautilo/config": "workspace:*",
    "@nautilo/db": "workspace:*",
    "@nautilo/logger": "workspace:*",
    "@nautilo/types": "workspace:*",
    "argon2": "0.44.0",
    "jose": "6.2.3"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "dotenv": "16.6.1",
    "typescript": "5.9.3"
  }
}
