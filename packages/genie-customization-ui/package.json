{
  "name": "@nautilo/genie-customization-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-neutral React UI for customizing a Nautilo Genie",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./types": {
      "import": "./src/types.ts",
      "types": "./src/types.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf .turbo node_modules"
  },
  "dependencies": {
    "@nautilo/types": "workspace:*",
    "@nautilo/voice-catalog-ui": "workspace:*",
    "react": "19.2.5",
    "three": "0.183.2"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/three": "0.183.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "5.9.3"
  }
}
