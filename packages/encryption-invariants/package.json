{
  "name": "@nautilo/encryption-invariants",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dependency-light encryption coverage, baseline-debt, activation, and inventory invariants.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf dist .turbo node_modules",
    "inventory": "bun src/node/generate-report.ts",
    "check": "bun src/node/generate-report.ts --check",
    "test": "bun run test:unit && bun run test:integration && bun run test:property",
    "test:unit": "bun test --timeout 30000 tests/unit/",
    "test:integration": "bun test --max-concurrency=1 --timeout 120000 tests/integration/",
    "test:property": "bun test --timeout 30000 tests/property/",
    "test:coverage": "bun --config=bunfig.coverage.toml test --timeout 30000 tests/unit tests/integration/dto-inventory-declarations.test.ts tests/integration/source-alarm-review.test.ts",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@nautilo/db": "workspace:*",
    "@nautilo/types": "workspace:*",
    "drizzle-orm": "0.45.2",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@stryker-mutator/core": "9.6.1",
    "@types/node": "24.10.4",
    "fast-check": "4.3.0"
  }
}
