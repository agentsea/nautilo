{
  "name": "@nautilo/logger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared logger for nautilo packages — stderr, file, or silent output",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf dist .turbo node_modules",
    "test": "bun test --timeout 15000",
    "test:unit": "bun test --timeout 15000 tests/unit/"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "typescript": "5.9.3"
  }
}
