{
  "name": "@nautilo/loffice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LibreOffice headless client + CLI (D362) — TS XML-RPC client for the nwuno/unoserver engine",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "loffice": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf dist .turbo node_modules",
    "test": "bun test --timeout 15000",
    "test:unit": "bun test --timeout 15000 src/"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "jimp": "^1.6.1"
  }
}
