{
  "name": "@nautilo/limit-invariants",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Developer-only deterministic limit inventory and reviewed-decision drift gate.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf dist .turbo node_modules",
    "inventory": "bun src/node/cli.ts inventory",
    "report": "bun src/node/cli.ts report",
    "check": "bun src/node/cli.ts check",
    "check:ci": "bun src/node/public-check.ts",
    "review": "bun src/node/review.ts",
    "scout": "bun src/node/cli.ts scout",
    "admit-legacy": "bun src/node/cli.ts admit-legacy",
    "shrink-legacy": "bun src/node/cli.ts shrink-legacy",
    "test": "bun run test:unit",
    "test:unit": "bun test tests/unit/"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "typescript": "5.9.3"
  }
}
