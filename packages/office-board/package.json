{
  "name": "@nautilo/office-board",
  "private": true,
  "version": "0.6.9",
  "license": "Apache-2.0",
  "description": "Nautilo-owned infinite canvas model, viewport and Miro mapping",
  "type": "module",
  "main": "dist/wafflebase-board.cjs",
  "module": "dist/wafflebase-board.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/wafflebase-board.es.js",
      "require": "./dist/wafflebase-board.cjs",
      "default": "./dist/wafflebase-board.es.js"
    },
    "./node": {
      "types": "./dist/index.d.ts",
      "import": "./dist/wafflebase-board.es.js",
      "require": "./dist/wafflebase-board.cjs",
      "default": "./dist/wafflebase-board.es.js"
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "import": "./dist/wafflebase-board.es.js",
      "require": "./dist/wafflebase-board.cjs",
      "default": "./dist/wafflebase-board.es.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest --run",
    "test:watch": "vitest --watch --passWithNoTests",
    "build": "vite --config vite.build.ts build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test:unit": "vitest --run && node scripts/qualify-exports.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:browser": "node scripts/qualify-browser.mjs"
  },
  "dependencies": {
    "@nautilo/office-docs": "workspace:*",
    "@nautilo/office-slides": "workspace:*",
    "parse5": "8.0.1"
  },
  "devDependencies": {
    "prettier": "^3.3.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.8",
    "playwright": "1.62.1"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE.md"
  ]
}
