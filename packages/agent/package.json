{
  "name": "@nautilo/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LangGraph-based assistant brain — graph definitions, tools, memory primitives",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./model-runtime-credentials": "./src/chat/model-runtime-credentials.ts",
    "./model-evaluation": "./src/providers/model-evaluation.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "computer-use-catalogue:export": "bun scripts/export-computer-use-contract-catalogue.ts",
    "tool-catalog-matrix:export": "bun scripts/export-tool-catalog-matrix.ts",
    "clean": "rm -rf dist .turbo node_modules",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "bash scripts/run-unit.sh",
    "test:integration": "bash scripts/run-integration.sh"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@langchain/anthropic": "1.3.29",
    "@langchain/core": "1.1.45",
    "@langchain/fireworks": "0.1.3",
    "@langchain/google-genai": "2.1.29",
    "@langchain/langgraph": "1.2.9",
    "@langchain/langgraph-checkpoint-postgres": "1.0.1",
    "@langchain/openai": "1.4.5",
    "@langchain/tavily": "1.2.0",
    "@langchain/xai": "1.3.17",
    "@nautilo/attachments": "workspace:*",
    "@nautilo/catalog": "workspace:*",
    "@nautilo/computer-use-contracts": "workspace:*",
    "@nautilo/computer-use-host-protocol": "workspace:*",
    "@nautilo/cloudconvert": "workspace:*",
    "@nautilo/config": "workspace:*",
    "@nautilo/config-guard": "workspace:*",
    "@nautilo/db": "workspace:*",
    "@nautilo/fonts": "workspace:*",
    "@nautilo/lattice-bridge": "workspace:*",
    "@nautilo/loffice": "workspace:*",
    "@nautilo/logger": "workspace:*",
    "@nautilo/message-invariants": "workspace:*",
    "@nautilo/model-capabilities": "workspace:*",
    "@nautilo/relay": "workspace:*",
    "@nautilo/sandbox": "workspace:*",
    "@nautilo/security": "workspace:*",
    "@nautilo/trust": "workspace:*",
    "@nautilo/types": "workspace:*",
    "@nautilo/vault": "workspace:*",
    "@nautilo/voice": "workspace:*",
    "@react-pdf/renderer": "4.5.1",
    "cron-parser": "^5.5.0",
    "diff": "9.0.0",
    "docx": "9.6.1",
    "linkedom": "0.18.12",
    "mdast-util-to-string": "4.0.0",
    "pg": "8.13.1",
    "react": "19.2.5",
    "remark": "15.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "write-file-atomic": "7.0.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@nautilo/document-mutations": "workspace:*",
    "@types/node": "24.10.4",
    "@types/pg": "8.11.10",
    "@types/react": "19.2.14",
    "@types/write-file-atomic": "4.0.3",
    "dotenv": "16.6.1",
    "jimp": "^1.6.1",
    "typescript": "5.9.3"
  }
}
