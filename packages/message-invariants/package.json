{
  "name": "@nautilo/message-invariants",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Centralized enforcement of the tool_use ↔ tool_result message invariant: stable IDs, merge dedupe, validation safety net, dev-mode assertions.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./eslint": "./eslint/index.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf dist .turbo node_modules",
    "test": "bun test --timeout 30000",
    "test:unit": "bun test --timeout 30000 tests/unit/"
  },
  "dependencies": {
    "@langchain/core": "1.1.45",
    "@nautilo/logger": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "@typescript-eslint/utils": "8.50.0",
    "@typescript-eslint/rule-tester": "8.50.0",
    "typescript": "5.9.3"
  }
}
