{
  "name": "@nautilo/claude-agent-sdk-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Desktop-side Claude Agent SDK projection boundary for Nautilo",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
