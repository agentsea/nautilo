    "test:unit": "bun test tests/unit/"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.93.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.235",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@nautilo/relay": "workspace:*",
    "@nautilo/vault": "workspace:*",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "typescript": "5.9.3"
