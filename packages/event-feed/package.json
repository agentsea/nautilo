{
  "name": "@nautilo/event-feed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed persistent personal event-feed engine",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
