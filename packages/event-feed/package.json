    "test": "bun run test:unit",
    "test:unit": "bun test tests/unit/"
  },
  "dependencies": {
    "@nautilo/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "typescript": "5.9.3"
  }
