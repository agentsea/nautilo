{
  "name": "@nautilo/catalog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tool registry — knows what tools exist, who can use them, and how to create them",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf dist .turbo node_modules",
    "test": "bun test --timeout 15000",
    "test:unit": "bun test --timeout 15000 tests/unit/"
  },
  "dependencies": {
    "@langchain/core": "1.1.45",
    "@nautilo/logger": "workspace:*",
    "@nautilo/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "typescript": "5.9.3",
    "zod": "4.3.6"
  }
}
