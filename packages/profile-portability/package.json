{
  "name": "@nautilo/profile-portability",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portable Genie profile migration \u2014 dependency-free pure TypeScript contract, validators, canonical hashing, and fixtures for the versioned semantic/container/protection boundaries (Wave 0 / P0).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./semantic": "./src/semantic/index.ts",
    "./container": "./src/container/index.ts",
    "./profile-bundle": "./src/profile-bundle.ts",
    "./protection": "./src/protection/index.ts",
    "./key-slots": "./src/key-slots/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf dist .turbo node_modules",
    "test": "bun test --timeout 30000",
    "test:unit": "bun test --timeout 30000 tests/unit/"
  },
  "dependencies": {
    "@noble/ciphers": "1.3.0",
    "@noble/hashes": "2.2.0"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "typescript": "5.9.3"
  }
}
