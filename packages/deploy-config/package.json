{
  "name": "@nautilo/deploy-config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Parse + validate + apply ~/.config/nautilo/deploy.toml (M091 deploy contract). Shared between @nautilo/cli (`nautilo deploy`) and @nautilo/dev-tools (`bun run dev:setup`).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf dist .turbo node_modules",
    "test": "bun test --timeout 15000 tests/unit/",
    "test:unit": "bun test --timeout 15000 tests/unit/"
  },
  "dependencies": {
    "@nautilo/api-client": "workspace:*",
    "@nautilo/config-guard": "workspace:*",
    "smol-toml": "1.8.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "typescript": "5.9.3"
  }
}
