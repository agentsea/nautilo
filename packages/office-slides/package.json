{
  "name": "@nautilo/office-slides",
  "private": true,
  "version": "0.6.9",
  "license": "Apache-2.0",
  "description": "Presentation engine for Wafflebase",
  "type": "module",
  "main": "dist/wafflebase-slides.cjs",
  "module": "dist/wafflebase-slides.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "node": {
        "types": "./dist/node.d.ts",
        "import": "./dist/node.js",
        "require": "./dist/node.cjs",
        "default": "./dist/node.js"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/wafflebase-slides.es.js",
      "require": "./dist/wafflebase-slides.cjs",
      "default": "./dist/wafflebase-slides.es.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs",
      "default": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "import": "./dist/wafflebase-slides.es.js",
      "require": "./dist/wafflebase-slides.cjs",
      "default": "./dist/wafflebase-slides.es.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest --run",
    "test:watch": "vitest --watch --passWithNoTests",
    "build": "vite --config vite.build.ts build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "gen:textrects": "node scripts/gen-shape-text-rects.mjs",
    "gen:model-schema": "node scripts/generate-model-schema.mjs",
    "check:model-schema": "node scripts/generate-model-schema.mjs --check",
    "format": "prettier --write .",
    "test:unit": "node scripts/generate-model-schema.mjs --check && vitest --run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@nautilo/office-core": "workspace:*",
    "@nautilo/office-docs": "workspace:*",
    "@xmldom/xmldom": "0.9.10",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.8",
    "ajv": "8.18.0",
    "fast-check": "^3",
    "jsdom": "^28.0.0",
    "prettier": "^3.3.2",
    "ts-json-schema-generator": "2.9.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.8"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE.md"
  ]
}
