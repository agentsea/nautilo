{
  "name": "@nautilo/sandbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OS-level sandbox containment for LLM-emitted shell commands — bubblewrap (Linux) + sandbox-exec (macOS). D060 Phase 1+2.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf dist .turbo node_modules",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "bun test --timeout 15000 tests/unit/",
    "test:integration": "bun test --timeout 60000 tests/integration/"
  },
  "dependencies": {
    "@nautilo/logger": "workspace:*",
    "ipaddr.js": "2.3.0"
  },
  "devDependencies": {
    "@nautilo/security": "workspace:*",
    "@types/node": "24.10.4",
    "typescript": "5.9.3"
  }
}
