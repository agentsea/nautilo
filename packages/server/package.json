{
  "name": "@nautilo/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify HTTP control plane \u2014 routing, middleware, real-time events",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf dist .turbo node_modules",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "bun scripts/run-unit.ts",
    "test:integration": "bash scripts/run-integration.sh",
    "test:integration:acp": "bash scripts/run-integration.sh tests/acp-integration",
    "test:integration:owner-claim-fresh": "bash scripts/run-integration.sh tests/fresh-instance-integration",
    "photo-library:backfill": "bun scripts/backfill-owned-photo-library.ts",
    "photo-library:gc": "bun scripts/gc-owned-photo-library.ts",
    "photo-library:recover": "bun scripts/recover-owned-photo-library.ts"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "@noble/ciphers": "1.3.0",
    "@aws-sdk/client-s3": "3.1108.0",
    "@aws-sdk/lib-storage": "3.1108.0",
    "@fastify/cors": "10.1.0",
    "@fastify/multipart": "10.0.0",
    "@fastify/static": "10.1.2",
    "@fastify/websocket": "11.3.0",
    "@langchain/core": "1.1.45",
    "@logto/core-kit": "2.9.0",
    "@oomol-lab/connector": "1.1.0",
    "@nautilo/acp-host": "workspace:*",
    "@nautilo/agent": "workspace:*",
    "@nautilo/api-client": "workspace:*",
    "@nautilo/attachments": "workspace:*",
    "@nautilo/catalog": "workspace:*",
    "@nautilo/config": "workspace:*",
    "@nautilo/config-guard": "workspace:*",
    "@nautilo/db": "workspace:*",
    "@nautilo/document-mutations": "workspace:*",
    "@nautilo/encryption-invariants": "workspace:*",
    "@nautilo/logger": "workspace:*",
    "@nautilo/lattice-crypto": "workspace:*",
    "@nautilo/mcp-client": "workspace:*",
    "@nautilo/operator-secrets": "workspace:*",
    "@nautilo/profile-portability": "workspace:*",
    "@nautilo/reflection": "workspace:*",
    "@nautilo/reflection-bridge": "workspace:*",
    "@nautilo/relay": "workspace:*",
    "@nautilo/runtime": "workspace:*",
    "@nautilo/sandbox": "workspace:*",
    "@nautilo/security": "workspace:*",
    "@nautilo/trust": "workspace:*",
    "@nautilo/types": "workspace:*",
    "@nautilo/vault": "workspace:*",
    "@nautilo/voice": "workspace:*",
    "@nautilo/writer-proposal-core": "workspace:*",
    "bonjour-service": "1.3.0",
    "diff": "9.0.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.11.2",
    "fflate": "^0.8.3",
    "pino": "10.3.1",
    "sharp": "0.35.4",
    "ws": "8.21.2",
    "zod": "4.3.6",
    "@nautilo/event-feed": "workspace:*"
  },
  "devDependencies": {
    "@nautilo/lattice-bridge": "workspace:*",
    "@nautilo/realtime-client": "workspace:*",
    "@nautilo/office-docs": "workspace:*",
    "@types/node": "24.10.4",
    "@types/ws": "8.18.1",
    "dotenv": "16.6.1",
    "jose": "6.2.3",
    "typescript": "5.9.3"
  }
}
