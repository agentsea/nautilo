{
  "name": "@nautilo/compose-lifecycle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reusable, structured lifecycle boundary for named Nautilo Compose instances",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf dist .turbo node_modules",
    "test": "bun run test:unit",
    "test:unit": "bun test --timeout 15000 tests/unit/",
    "test:integration": "bun test --timeout 1800000 tests/integration/"
  },
  "dependencies": {
    "@nautilo/compose-driver": "workspace:*",
    "@nautilo/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "typescript": "5.9.3"
  }
}
