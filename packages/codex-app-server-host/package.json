{
  "name": "@nautilo/codex-app-server-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Paired-workspace authority and lifecycle supervision for Codex app-server hosts",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./internal": {
      "types": "./src/internal.ts",
      "import": "./src/internal.ts"
    },
    "./node": {
      "types": "./src/node.ts",
      "import": "./src/node.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf dist .turbo node_modules",
    "test": "bun run test:unit",
    "test:unit": "bun test --timeout 15000 tests/unit/"
  },
  "dependencies": {
    "@nautilo/acp-host": "workspace:*",
    "@nautilo/codex-app-server": "workspace:*",
    "@nautilo/relay": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "typescript": "5.9.3"
  }
}
