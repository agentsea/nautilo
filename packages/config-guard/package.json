{
  "name": "@nautilo/config-guard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Transactional .env updates with snapshots, validation, and rollback",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./managed-gateway": "./src/managed-gateway.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf dist .turbo node_modules",
    "test": "bun test --timeout 15000 tests/unit/",
    "test:unit": "bun test --timeout 15000 tests/unit/"
  },
  "dependencies": {
    "@nautilo/config": "workspace:*",
    "@nautilo/logger": "workspace:*",
    "@nautilo/types": "workspace:*",
    "dotenv": "16.6.1",
    "smol-toml": "1.8.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@nautilo/model-capabilities": "workspace:*",
    "@types/node": "24.10.4",
    "typescript": "5.9.3"
  }
}
