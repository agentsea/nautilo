{
  "name": "@nautilo/realtime-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ably/WebSocket subscription wrapper and event type definitions",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf dist .turbo node_modules",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "bun test tests/unit/",
    "test:integration": "bun test --timeout 15000 tests/integration/"
  },
  "dependencies": {
    "@nautilo/types": "workspace:*"
  },
  "devDependencies": {
    "@fastify/websocket": "11.3.0",
    "@types/node": "24.10.4",
    "@types/ws": "8.18.1",
    "fastify": "5.11.2",
    "typescript": "5.9.3"
  }
}
