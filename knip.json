        "@mdxeditor/lexical-code",
        "@mdxeditor/lexical-devtools-core",
        "@mdxeditor/lexical-dragon",
        "@mdxeditor/lexical-hashtag",
        "@mdxeditor/lexical-history",
        "@mdxeditor/lexical-html",
        "@mdxeditor/lexical-link",
        "@mdxeditor/lexical-list",
        "@mdxeditor/lexical-mark",
        "@mdxeditor/lexical-markdown",
        "@mdxeditor/lexical-offset",
        "@mdxeditor/lexical-overflow",
        "@mdxeditor/lexical-plain-text",
        "@mdxeditor/lexical-react",
        "@mdxeditor/lexical-rich-text",
        "@mdxeditor/lexical-selection",
        "@mdxeditor/lexical-table",
        "@mdxeditor/lexical-text",
        "@mdxeditor/lexical-utils",
        "@mdxeditor/lexical-yjs"
