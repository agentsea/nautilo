    "apps/workbench/src/artifacts/workspace-document-mutation-events.ts": ["exports"],
    "apps/mobile/src/lib/settings-reauth-navigation.ts": ["exports"],
    "packages/agent/src/tools/apply-patch/contract.ts": ["exports", "types"],
